# ==============================================================================
# نظام إدارة المدرسة المتكامل - الإصدار العربي الشامل
# ==============================================================================

class النظام_المدرسي:
    def __init__(self, اسم_المدرسة):
        self.اسم_المدرسة = اسم_المدرسة
        self.قائمة_الطلاب = []
        self.قائمة_المعلمين = []
        self.قائمة_المواد = []
        self.سجل_الدرجات = {}
        self.سجل_النشاطات = []

    # --------------------------------------------------------------------------
    # دوال إدارة الطلاب
    # --------------------------------------------------------------------------
    def تسجيل_طالب_جديد(self, رقم_الطالب, الاسم_الكامل, العمر, الصف, العنوان, رقم_الهاتف):
        طالب = {
            "رقم_الطالب": رقم_الطالب,
            "الاسم_الكامل": الاسم_الكامل,
            "العمر": العمر,
            "الصف": الصف,
            "العنوان": العنوان,
            "رقم_الهاتف": رقم_الهاتف,
            "الحالة": "نشط"
        }
        self.قائمة_الطلاب.append(طالب)
        self.سجل_النشاطات.append(f"تم تسجيل الطالب الجديد: {الاسم_الكامل}")
        print(f"[نجاح] تم إضافة الطالب {الاسم_الكامل} بنجاح.")

    def حذف_طالب(self, رقم_الطالب):
        for طالب in self.قائمة_الطلاب:
            if طالب["رقم_الطالب"] == رقم_الطالب:
                self.قائمة_الطلاب.remove(طالب)
                self.سجل_النشاطات.append(f"تم حذف الطالب برقم: {رقم_الطالب}")
                print(f"[نجاح] تم حذف الطالب رقم {رقم_الطالب} بنجاح.")
                return
        print("[خطأ] لم يتم العثور على الطالب بهذا الرقم.")

    def تعديل_بيانات_طالب(self, رقم_الطالب, اسم_جديد=None, عمر_جديد=None, صف_جديد=None):
        for طالب in self.قائمة_الطلاب:
            if طالب["رقم_الطالب"] == رقم_الطالب:
                if اسم_جديد:
                    طالب["الاسم_الكامل"] = اسم_جديد
                if عمر_جديد:
                    طالب["العمر"] = عمر_جديد
                if صف_جديد:
                    طالب["الصف"] = صف_جديد
                self.سجل_النشاطات.append(f"تم تحديث بيانات الطالب رقم: {رقم_الطالب}")
                print(f"[نجاح] تم تحديث بيانات الطالب رقم {رقم_الطالب}.")
                return
        print("[خطأ] الطالب غير موجود.")

    def عرض_جميع_الطلاب(self):
        print("\n--- قائمة جميع الطلاب المسجلين ---")
        if not self.قائمة_الطلاب:
            print("لا يوجد طلاب مسجلون حالياً.")
            return
        for طالب in self.قائمة_الطلاب:
            print(f"الرقم: {طالب['رقم_الطالب']} | الاسم: {طالب['الاسم_الكامل']} | العمر: {طالب['العمر']} | الصف: {طالب['الصف']} | الحالة: {طالب['الحالة']}")

    # --------------------------------------------------------------------------
    # دوال إدارة المعلمين
    # --------------------------------------------------------------------------
    def تعيين_معلم_جديد(self, رقم_المعلم, الاسم_الكامل, التخصص, سنوات_الخبرة, الراتب):
        معلم = {
            "رقم_المعلم": رقم_المعلم,
            "الاسم_الكامل": الاسم_الكامل,
            "التخصص": التخصص,
            "سنوات_الخبرة": سنوات_الخبرة,
            "الراتب": الراتب,
            "الحالة": "على رأس العمل"
        }
        self.قائمة_المعلمين.append(معلم)
        self.سجل_النشاطات.append(f"تم تعيين معلم جديد: {الاسم_الكامل} تخصص {التخصص}")
        print(f"[نجاح] تم تعيين المعلم {الاسم_الكامل} بنجاح.")

    def فصل_معلم(self, رقم_المعلم):
        for معلم in self.قائمة_المعلمين:
            if معلم["رقم_المعلم"] == رقم_المعلم:
                self.قائمة_المعلمين.remove(معلم)
                self.سجل_النشاطات.append(f"تم إنهاء خدمة المعلم برقم: {رقم_المعلم}")
                print(f"[نجاح] تم إنهاء خدمة المعلم رقم {رقم_المعلم}.")
                return
        print("[خطأ] المعلم غير موجود.")

    def عرض_جميع_المعلمين(self):
        print("\n--- قائمة المعلمين والكادر التعليمي ---")
        if not self.قائمة_المعلمين:
            print("لا يوجد معلمون مسجلون حالياً.")
            return
        for معلم in self.قائمة_المعلمين:
            print(f"الرقم: {معلم['رقم_المعلم']} | الاسم: {معلم['الاسم_الكامل']} | التخصص: {معلم['التخصص']} | الخبرة: {معلم['سنوات_الخبرة']} سنوات")

    # --------------------------------------------------------------------------
    # دوال إدارة المواد الدراسية
    # --------------------------------------------------------------------------
    def اضافة_مادة_دراسية(self, رمز_المادة, اسم_المادة, الحد_المقصود_للدرجة):
        مادة = {
            "رمز_المادة": رمز_المادة,
            "اسم_المادة": اسم_المادة,
            "الحد_الأقصى": الحد_المقصود_للدرجة
        }
        self.قائمة_المواد.append(مادة)
        self.سجل_النشاطات.append(f"تمت إضافة مادة دراسية: {اسم_المادة}")
        print(f"[نجاح] تمت إضافة المادة {اسم_المادة} بنجاح.")

    def عرض_المواد_الدراسية(self):
        print("\n--- قائمة المواد الدراسية المتاحة ---")
        if not self.قائمة_المواد:
            print("لا توجد مواد دراسية مسجلة.")
            return
        for مادة in self.قائمة_المواد:
            print(f"الرمز: {مادة['رمز_المادة']} | اسم المادة: {مادة['اسم_المادة']} | الدرجة القصوى: {مادة['الحد_الأقصى']}")

    # --------------------------------------------------------------------------
    # دوال رصد الدرجات والتقييمات
    # --------------------------------------------------------------------------
    def رصد_درجة_طالب(self, رقم_الطالب, رمز_المادة, الدرجة):
        # التحقق من وجود الطالب والمادة
        طالب_موجود = any(ط["رقم_الطالب"] == رقم_الطالب for ط in self.قائمة_الطلاب)
        مادة_موجودة = any(م["رمز_المادة"] == رمز_المادة for م in self.قائمة_المواد)
        
        if not طالب_موجود or not مادة_موجودة:
            print("[خطأ] الطالب أو المادة الدراسية غير مسجلة في النظام.")
            return

         مفتاح_السجل = (رقم_الطالب, رمز_المادة)
        self.سجل_الدرجات[مفتاح_السجل] = الدرجة
        self.سجل_النشاطات.append(f"تم رصد درجة للطالب {رقم_الطالب} في المادة {رمز_المادة}: {الدرجة}")
        print(f"[نجاح] تم رصد الدرجة بنجاح.")

    def استعلام_عن_درجات_طالب(self, رقم_الطالب):
        print(f"\n--- كشف درجات الطالب رقم: {رقم_الطالب} ---")
        وجد_درجات = False
        for (ط_رقم, م_رمز), درحة in self.سجل_الدرجات.items():
            if ط_رقم == رقم_الطالب:
                print(f"المادة: {م_رمز} | الدرجة: {درحة}")
                وجد_درجات = True
        if not وجد_درجات:
            print("لا توجد درجات مسجلة لهذا الطالب حتى الآن.")

    # --------------------------------------------------------------------------
    # دوال التقارير والتدقيق الشامل
    # --------------------------------------------------------------------------
    def طباعة_سجل_النشاطات(self):
        print("\n--- سجل الأنشطة والعمليات في النظام ---")
        if not self.سجل_النشاطات:
            print("السجل فارغ.")
            return
        for نشاط in self.سجل_النشاطات:
            print(f"- {نشاط}")

    def إحصائيات_عامة(self):
        print("\n================ إحصائيات النظام العامة ================")
        print(f"اسم المدرسة: {self.اسم_المدرسة}")
        print(f"إجمالي عدد الطلاب المسجلين: {len(self.قائمة_الطلاب)}")
        print(f"إجمالي عدد المعلمين: {len(self.قائمة_المعلمين)}")
        print(f"إجمالي عدد المواد الدراسية: {len(self.قائمة_المواد)}")
        print(f"عدد العمليات المسجلة في السجل: {len(self.سجل_النشاطات)}")
        print("=========================================================")


